rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // ===============================================================
    // Assumed Data Model
    // ===============================================================
    //
    // Collection: users/{userId}/accounts
    // Document ID: accountId
    // Fields:
    //   - id: string
    //   - name: string
    //   - type: string (asset, liability, equity, income, expense)
    //   - liquidity: string (optional)
    //   - expenseType: string (optional)
    //   - budget: number (optional)
    //   - excludeFromForecast: boolean (optional)
    //   - isArchived: boolean
    //   - pots: string (optional, JSON)
    //   - uid: string
    //
    // Collection: users/{userId}/transactions
    // Document ID: transactionId
    // Fields:
    //   - id: string
    //   - date: string
    //   - description: string
    //   - amount: number
    //   - debitAccount: string
    //   - creditAccount: string
    //   - cleared: boolean
    //   - receipt: string (optional)
    //   - uid: string
    //
    // Collection: users/{userId}/recurring
    // Document ID: recurringId
    // Fields:
    //   - id: string
    //   - description: string
    //   - amount: number
    //   - debitAccount: string
    //   - creditAccount: string
    //   - day: number
    //   - uid: string
    //
    // Collection: users/{userId}/goals
    // Document ID: goalId
    // Fields:
    //   - id: string
    //   - name: string
    //   - targetAmount: number
    //   - linkedAccountId: string
    //   - uid: string
    //
    // ===============================================================

    // ===============================================================
    // Helper Functions
    // ===============================================================
    
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }
    
    function isDocOwner() {
      return isAuthenticated() && 
             (!('uid' in resource.data) || request.auth.uid == resource.data.uid);
    }
    
    function uidUnchanged() {
      return !('uid' in request.resource.data) || request.resource.data.uid == request.auth.uid;
    }
    
    function uidNotModified() {
      return !('uid' in request.resource.data) || 
             !('uid' in resource.data) || 
             request.resource.data.uid == resource.data.uid;
    }
    
    function hasRequiredFields(fields) {
      return request.resource.data.keys().hasAll(fields);
    }
    
    function validStringLength(field, minLen, maxLen) {
      return request.resource.data[field] is string &&
        request.resource.data[field].size() >= minLen &&
        request.resource.data[field].size() <= maxLen;
    }

    // ===============================================================
    // Domain Validators
    // ===============================================================

    function isValidAccount() {
      let data = request.resource.data;
      return hasRequiredFields(['id', 'name', 'type', 'isArchived', 'uid']) &&
             data.id is string && data.id.size() > 0 && data.id.size() < 100 &&
             data.name is string && data.name.size() > 0 && data.name.size() < 100 &&
             data.type in ['asset', 'liability', 'equity', 'income', 'expense'] &&
             data.isArchived is bool &&
             (!('liquidity' in data) || data.liquidity in ['liquid', 'invested']) &&
             (!('expenseType' in data) || data.expenseType in ['need', 'want']) &&
             (!('budget' in data) || data.budget is number) &&
             (!('excludeFromForecast' in data) || data.excludeFromForecast is bool) &&
             (!('pots' in data) || (data.pots is list && data.pots.size() < 100));
    }

    function isValidTransaction() {
      let data = request.resource.data;
      return hasRequiredFields(['id', 'date', 'description', 'amount', 'debitAccount', 'creditAccount', 'cleared', 'uid']) &&
             data.id is string && data.id.size() > 0 && data.id.size() < 100 &&
             data.date is string && data.date.size() > 0 && data.date.size() < 50 &&
             data.description is string && data.description.size() >= 0 && data.description.size() < 500 &&
             data.amount is number &&
             data.debitAccount is string && data.debitAccount.size() > 0 && data.debitAccount.size() < 100 &&
             data.creditAccount is string && data.creditAccount.size() > 0 && data.creditAccount.size() < 100 &&
             data.cleared is bool &&
             (!('receipt' in data) || data.receipt == null || (data.receipt is string && data.receipt.size() < 1000000)) &&
             (!('tags' in data) || (data.tags is list && data.tags.size() < 100)) &&
             (!('merchant' in data) || (data.merchant is string && data.merchant.size() < 100)) &&
             (!('intent' in data) || data.intent in ['need', 'want', 'investment', 'transfer']) &&
             (!('groupId' in data) || (data.groupId is string && data.groupId.size() < 100)) &&
             (!('splits' in data) || (data.splits is list && data.splits.size() < 100));
    }

    function isValidRecurring() {
      let data = request.resource.data;
      return hasRequiredFields(['id', 'description', 'amount', 'debitAccount', 'creditAccount', 'day', 'uid']) &&
             data.id is string && data.id.size() > 0 && data.id.size() < 100 &&
             data.description is string && data.description.size() >= 0 && data.description.size() < 500 &&
             data.amount is number &&
             data.debitAccount is string && data.debitAccount.size() > 0 && data.debitAccount.size() < 100 &&
             data.creditAccount is string && data.creditAccount.size() > 0 && data.creditAccount.size() < 100 &&
             data.day is number && data.day >= 1 && data.day <= 31;
    }

    function isValidGoal() {
      let data = request.resource.data;
      return hasRequiredFields(['id', 'name', 'targetAmount', 'linkedAccountId', 'uid']) &&
             data.id is string && data.id.size() > 0 && data.id.size() < 100 &&
             data.name is string && data.name.size() > 0 && data.name.size() < 100 &&
             data.targetAmount is number && data.targetAmount >= 0 &&
             data.linkedAccountId is string && data.linkedAccountId.size() > 0 && data.linkedAccountId.size() < 100;
    }

    function isValidBudget() {
      let data = request.resource.data;
      return hasRequiredFields(['id', 'limit', 'period', 'uid']) &&
             data.id is string && data.id.size() > 0 && data.id.size() < 100 &&
             data.limit is number && data.limit >= 0 &&
             data.period == 'monthly' &&
             (!('tag' in data) || (data.tag is string && data.tag.size() > 0 && data.tag.size() < 100)) &&
             (!('accountId' in data) || (data.accountId is string && data.accountId.size() > 0 && data.accountId.size() < 100));
    }

    function isValidTemplate() {
      let data = request.resource.data;
      return hasRequiredFields(['id', 'name', 'description', 'amount', 'debitAccount', 'creditAccount', 'uid']) &&
             data.id is string && data.id.size() > 0 && data.id.size() < 100 &&
             data.name is string && data.name.size() > 0 && data.name.size() < 100 &&
             data.description is string && data.description.size() >= 0 && data.description.size() < 500 &&
             data.amount is number &&
             data.debitAccount is string && data.debitAccount.size() > 0 && data.debitAccount.size() < 100 &&
             data.creditAccount is string && data.creditAccount.size() > 0 && data.creditAccount.size() < 100 &&
             (!('tags' in data) || (data.tags is list && data.tags.size() < 100)) &&
             (!('merchant' in data) || (data.merchant is string && data.merchant.size() < 100));
    }

    function isValidFund() {
      let data = request.resource.data;
      return hasRequiredFields(['id', 'name', 'balance', 'uid']) &&
             data.id is string && data.id.size() > 0 && data.id.size() < 100 &&
             data.name is string && data.name.size() > 0 && data.name.size() < 100 &&
             data.balance is number && data.balance >= 0 &&
             (!('target' in data) || (data.target is number && data.target >= 0));
    }

    function isValidPortfolioItem() {
      let data = request.resource.data;
      return hasRequiredFields(['id', 'name', 'type', 'investedAmount', 'currentValue', 'uid']) &&
             data.id is string && data.id.size() > 0 && data.id.size() < 100 &&
             data.name is string && data.name.size() > 0 && data.name.size() < 100 &&
             data.type is string && data.type.size() > 0 && data.type.size() < 50 &&
             data.investedAmount is number && data.investedAmount >= 0 &&
             data.currentValue is number && data.currentValue >= 0 &&
             (!('quantity' in data) || (data.quantity is number && data.quantity >= 0)) &&
             (!('investmentType' in data) || (data.investmentType is string && data.investmentType.size() < 50)) &&
             (!('linkToAccountId' in data) || (data.linkToAccountId is string && data.linkToAccountId.size() < 100));
    }

    function isValidStat() {
      let data = request.resource.data;
      return data.keys().hasOnly(['lastActiveDate', 'streak']) &&
             (!('lastActiveDate' in data) || (data.lastActiveDate is string && data.lastActiveDate.size() < 20)) &&
             (!('streak' in data) || data.streak is number);
    }

    function isValidPreferences() {
      let data = request.resource.data;
      return data.keys().hasOnly(['spendableAccounts', 'hideBalances', 'advancedMode']) &&
             (!('spendableAccounts' in data) || (data.spendableAccounts is list && data.spendableAccounts.size() < 100)) &&
             (!('hideBalances' in data) || data.hideBalances is bool) &&
             (!('advancedMode' in data) || data.advancedMode is bool);
    }

    // ===============================================================
    // Rules
    // ===============================================================

    match /users/{userId} {
      match /accounts/{accountId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId) && isValidAccount() && uidUnchanged();
        allow update: if isOwner(userId) && isDocOwner() && isValidAccount() && uidNotModified();
        allow delete: if isOwner(userId) && isDocOwner();
      }
      
      match /transactions/{transactionId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId) && isValidTransaction() && uidUnchanged();
        allow update: if isOwner(userId) && isDocOwner() && isValidTransaction() && uidNotModified();
        allow delete: if isOwner(userId) && isDocOwner();
      }
      
      match /recurring/{recurringId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId) && isValidRecurring() && uidUnchanged();
        allow update: if isOwner(userId) && isDocOwner() && isValidRecurring() && uidNotModified();
        allow delete: if isOwner(userId) && isDocOwner();
      }
      
      match /goals/{goalId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId) && isValidGoal() && uidUnchanged();
        allow update: if isOwner(userId) && isDocOwner() && isValidGoal() && uidNotModified();
        allow delete: if isOwner(userId) && isDocOwner();
      }
      
      match /budgets/{budgetId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId) && isValidBudget() && uidUnchanged();
        allow update: if isOwner(userId) && isDocOwner() && isValidBudget() && uidNotModified();
        allow delete: if isOwner(userId) && isDocOwner();
      }
      
      match /templates/{templateId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId) && isValidTemplate() && uidUnchanged();
        allow update: if isOwner(userId) && isDocOwner() && isValidTemplate() && uidNotModified();
        allow delete: if isOwner(userId) && isDocOwner();
      }
      
      match /funds/{fundId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId) && isValidFund() && uidUnchanged();
        allow update: if isOwner(userId) && isDocOwner() && isValidFund() && uidNotModified();
        allow delete: if isOwner(userId) && isDocOwner();
      }
      
      match /portfolioItems/{itemId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId) && isValidPortfolioItem() && uidUnchanged();
        allow update: if isOwner(userId) && isDocOwner() && isValidPortfolioItem() && uidNotModified();
        allow delete: if isOwner(userId) && isDocOwner();
      }
      
      match /stats/activity {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId) && isValidStat();
        allow update: if isOwner(userId) && isValidStat();
        allow delete: if isOwner(userId);
      }
      
      match /settings/preferences {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId) && isValidPreferences();
        allow update: if isOwner(userId) && isValidPreferences();
        allow delete: if isOwner(userId);
      }
    }
  }
}
