{
  "entities": {
    "Account": {
      "title": "Account",
      "description": "A financial account (asset, liability, equity, income, expense)",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "type": {
          "type": "string",
          "enum": ["asset", "liability", "equity", "income", "expense"]
        },
        "liquidity": { "type": "string", "enum": ["liquid", "invested"] },
        "expenseType": { "type": "string", "enum": ["need", "want"] },
        "budget": { "type": "number" },
        "excludeFromForecast": { "type": "boolean" },
        "isArchived": { "type": "boolean" },
        "pots": {
          "type": "string",
          "description": "JSON stringified array of pots"
        },
        "uid": { "type": "string" }
      },
      "required": ["id", "name", "type", "isArchived", "uid"]
    },
    "Transaction": {
      "title": "Transaction",
      "description": "A financial transaction between two accounts",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "date": { "type": "string" },
        "description": { "type": "string" },
        "amount": { "type": "number" },
        "debitAccount": { "type": "string" },
        "creditAccount": { "type": "string" },
        "cleared": { "type": "boolean" },
        "receipt": { "type": "string" },
        "uid": { "type": "string" }
      },
      "required": [
        "id",
        "date",
        "description",
        "amount",
        "debitAccount",
        "creditAccount",
        "cleared",
        "uid"
      ]
    },
    "Recurring": {
      "title": "Recurring",
      "description": "A recurring template for transactions",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "description": { "type": "string" },
        "amount": { "type": "number" },
        "debitAccount": { "type": "string" },
        "creditAccount": { "type": "string" },
        "day": { "type": "number" },
        "uid": { "type": "string" }
      },
      "required": [
        "id",
        "description",
        "amount",
        "debitAccount",
        "creditAccount",
        "day",
        "uid"
      ]
    },
    "Goal": {
      "title": "Goal",
      "description": "A smart financial goal linked to an account",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "targetAmount": { "type": "number" },
        "linkedAccountId": { "type": "string" },
        "uid": { "type": "string" }
      },
      "required": ["id", "name", "targetAmount", "linkedAccountId", "uid"]
    },
    "Budget": {
      "title": "Budget",
      "description": "A budget limit for a specific tag",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "tag": { "type": "string" },
        "limit": { "type": "number" },
        "period": { "type": "string", "enum": ["monthly"] },
        "uid": { "type": "string" }
      },
      "required": ["id", "tag", "limit", "period", "uid"]
    },
    "TransactionTemplate": {
      "title": "TransactionTemplate",
      "description": "A template for quick-add transactions",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "description": { "type": "string" },
        "amount": { "type": "number" },
        "debitAccount": { "type": "string" },
        "creditAccount": { "type": "string" },
        "tags": { "type": "array", "items": { "type": "string" } },
        "merchant": { "type": "string" },
        "uid": { "type": "string" }
      },
      "required": [
        "id",
        "name",
        "description",
        "amount",
        "debitAccount",
        "creditAccount",
        "uid"
      ]
    },
    "Fund": {
      "title": "Fund",
      "description": "A user's allocated fund",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "balance": { "type": "number" },
        "target": { "type": "number" },
        "uid": { "type": "string" }
      },
      "required": ["id", "name", "balance", "uid"]
    },
    "PortfolioItem": {
      "title": "PortfolioItem",
      "description": "A user's investment portfolio asset",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "type": { "type": "string" },
        "investedAmount": { "type": "number" },
        "currentValue": { "type": "number" },
        "linkToAccountId": { "type": "string" },
        "quantity": { "type": "number" }
      },
      "required": ["id", "name", "type", "investedAmount", "currentValue"]
    },
    "Preferences": {
      "title": "Preferences",
      "description": "User preferences",
      "type": "object",
      "properties": {
        "spendableAccounts": { "type": "array", "items": { "type": "string" } },
        "hideBalances": { "type": "boolean" },
        "advancedMode": { "type": "boolean" }
      }
    },
    "ReverseBudget": {
      "title": "ReverseBudget",
      "description": "User's Reverse Budget and Guilt-Free Splurge Pot configuration",
      "type": "object",
      "properties": {
        "monthlyIncomeMode": { "type": "string", "enum": ["auto", "manual"] },
        "manualIncomeAmount": { "type": "number" },
        "fixedBillsMode": { "type": "string", "enum": ["auto", "custom"] },
        "customBills": { "type": "array", "items": { "type": "object" } },
        "sipMode": { "type": "string", "enum": ["auto", "custom"] },
        "customSipAmount": { "type": "number" },
        "emergencySavingsMode": { "type": "string", "enum": ["percentage", "fixed"] },
        "emergencySavingsValue": { "type": "number" },
        "emergencyAccountId": { "type": "string" },
        "rolloverUnspent": { "type": "boolean" },
        "uid": { "type": "string" }
      }
    }
  },
  "firestore": {
    "/users/{userId}/accounts/{accountId}": {
      "schema": { "$ref": "#/entities/Account" },
      "description": "User's financial accounts"
    },
    "/users/{userId}/transactions/{transactionId}": {
      "schema": { "$ref": "#/entities/Transaction" },
      "description": "User's financial transactions"
    },
    "/users/{userId}/recurring/{recurringId}": {
      "schema": { "$ref": "#/entities/Recurring" },
      "description": "User's recurring templates"
    },
    "/users/{userId}/goals/{goalId}": {
      "schema": { "$ref": "#/entities/Goal" },
      "description": "User's financial goals"
    },
    "/users/{userId}/budgets/{budgetId}": {
      "schema": { "$ref": "#/entities/Budget" },
      "description": "User's tag-based budgets"
    },
    "/users/{userId}/templates/{templateId}": {
      "schema": { "$ref": "#/entities/TransactionTemplate" },
      "description": "User's quick-add transaction templates"
    },
    "/users/{userId}/funds/{fundId}": {
      "schema": { "$ref": "#/entities/Fund" },
      "description": "User's allocated funds"
    },
    "/users/{userId}/portfolioItems/{itemId}": {
      "schema": { "$ref": "#/entities/PortfolioItem" },
      "description": "User's investment portfolio items"
    },
    "/users/{userId}/settings/preferences": {
      "schema": { "$ref": "#/entities/Preferences" },
      "description": "User's app preferences"
    },
    "/users/{userId}/settings/reverseBudget": {
      "schema": { "$ref": "#/entities/ReverseBudget" },
      "description": "User's Reverse Budget and Splurge Pot configuration"
    }
  }
}
